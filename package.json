{
  "name": "pi-web-engine",
  "version": "0.1.1",
  "description": "🔍 Native OpenAI Codex Web Search and Secure, Readable Web Fetching for Pi",
  "keywords": [
    "ai",
    "chatgpt",
    "codex",
    "openai",
    "openai-codex",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "pi-package",
    "ssrf",
    "web-fetch",
    "web-search"
  ],
  "homepage": "https://github.com/WolfieLeader/pi-web-engine#readme",
  "bugs": {
    "url": "https://github.com/WolfieLeader/pi-web-engine/issues"
  },
  "license": "MIT",
  "author": "WolfieLeader",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WolfieLeader/pi-web-engine.git"
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "audit:prod": "pnpm audit --prod",
    "build": "tsdown",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm knip",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "lint": "oxlint --type-aware --type-check --deny-warnings --report-unused-disable-directives .",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm check",
    "release:check": "pnpm check && pnpm audit:prod && npm pack --dry-run",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "ipaddr.js": "^2.5.0",
    "linkedom": "^0.18.12",
    "turndown": "^7.2.2",
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.4",
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@oxlint/plugins": "1.80.0",
    "@types/node": "^26.0.0",
    "@types/turndown": "^5.0.6",
    "knip": "^6.34.0",
    "oxfmt": "^0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsdown": "^0.22.14",
    "typebox": "1.3.7",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@11.9.0",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
