{
  "name": "pi-websearch",
  "version": "0.0.1",
  "description": "Native OpenAI Codex web search and secure web fetching for Pi",
  "keywords": [
    "codex",
    "openai",
    "pi-extension",
    "pi-package",
    "web-fetch",
    "web-search"
  ],
  "homepage": "https://github.com/WolfieLeader/pi-web-search#readme",
  "bugs": {
    "url": "https://github.com/WolfieLeader/pi-web-search/issues"
  },
  "license": "MIT",
  "author": "WolfieLeader",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WolfieLeader/pi-web-search.git"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm knip",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "lint": "oxlint --type-aware --deny-warnings .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "linkedom": "^0.18.12",
    "turndown": "^7.2.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.4",
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@types/node": "^26.0.0",
    "@types/turndown": "^5.0.6",
    "knip": "^6.34.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@11.9.0",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
